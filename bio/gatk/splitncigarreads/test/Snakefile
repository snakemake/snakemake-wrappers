rule splitncigarreads:
    input:
        bam="mapped/{sample}.bam",
        ref="genome.fasta",
    output:
        "split/{sample}.bam",
    log:
        "logs/gatk/splitNCIGARreads/{sample}.log",
    resources:
        mem_mb=1024,
    params:
        extra="",
        java_opts="",
    wrapper:
        "master/bio/gatk/splitncigarreads"
