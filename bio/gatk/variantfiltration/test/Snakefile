rule gatk_filter:
    input:
        vcf="calls/snvs.vcf",
        ref="genome.fasta",
        #intervals="targets.bed",
    output:
        vcf="calls/snvs.filtered.vcf",
    log:
        "logs/gatk/filter/snvs.log",
    resources:
        mem_mb=1024,
    params:
        filters={"myfilter": "AB < 0.2 || MQ0 > 50"},
        extra="",
        java_opts="",
    wrapper:
        "master/bio/gatk/variantfiltration"
