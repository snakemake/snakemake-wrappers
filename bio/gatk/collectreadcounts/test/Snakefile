rule collectreadcounts:
    input:
        bam=["mapped/a.bam"],
        intervals=["a.interval_list"],
    output:
        counts="a.counts.hdf5",
    log:
        "logs/gatk/collectreadcounts.log",
    resources:
        mem_mb=1024,
    params:
        extra="",
        java_opts="",
    wrapper:
        "master/bio/gatk/collectreadcounts"
