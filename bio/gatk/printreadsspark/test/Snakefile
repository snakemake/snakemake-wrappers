rule gatk_printreadsspark:
    input:
        bam="mapped/{sample}.bam",
        ref="genome.fasta",
        dict="genome.dict",
    output:
        bam="{sample}.bam",
    log:
        "logs/{sample}.log",
    threads: 8
    resources:
        mem_mb=1024,
    params:
        extra="",
        java_opts="",
        #spark_runner="",
        #spark_master="",
        #spark_extra="",
    wrapper:
        "master/bio/gatk/printreadsspark"
