rule gatk_applybqsr_spark:
    input:
        bam="mapped/{sample}.bam",
        ref="genome.fasta",
        dict="genome.dict",
        recal_table="recal/{sample}.grp",
    output:
        bam="recal/{sample}.bam",
    log:
        "logs/gatk/applybqsr_spark/{sample}.log",
    resources:
        mem_mb=1024,
    params:
        extra="",
        java_opts="",
        #spark_runner="",
        #spark_master="",
        #spark_extra="",
    wrapper:
        "master/bio/gatk/applybqsrspark"


