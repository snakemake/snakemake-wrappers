rule gatk_filtermutectcalls:
    input:
        vcf="calls/snvs.vcf",
        ref="genome.fasta",
    output:
        vcf="calls/snvs.mutect.filtered.vcf",
    log:
        "logs/gatk/filter/snvs.log",
    resources:
        mem_mb=1024,
    params:
        extra="--max-alt-allele-count 3",
        java_opts="",
    wrapper:
        "master/bio/gatk/filtermutectcalls"


rule gatk_filtermutectcalls_complete:
    input:
        vcf="calls/snvs.vcf",
        ref="genome.fasta",
        bam="mapped/a.bam",
        intervals="intervals.bed",
        #From gatk CalculateContamination
        # contamination="",
        # segmentation="",
        #From gatk LearnReadOrientationBias
        # f1r2="",
    output:
        vcf="calls/snvs.mutect.filtered.b.vcf",
    log:
        "logs/gatk/filter/snvs.log",
    resources:
        mem_mb=1024,
    params:
        extra="--max-alt-allele-count 3",
        java_opts="",
    wrapper:
        "master/bio/gatk/filtermutectcalls"
