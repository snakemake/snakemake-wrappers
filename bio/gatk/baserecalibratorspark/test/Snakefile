rule gatk_baserecalibratorspark:
    input:
        bam="mapped/{sample}.bam",
        ref="genome.fasta",
        dict="genome.dict",
        known="dbsnp.vcf.gz",
    output:
        recal_table="recal/{sample}.grp",
    log:
        "logs/gatk/baserecalibrator/{sample}.log",
    threads: 8
    resources:
        mem_mb=1024,
    params:
        extra="",
        java_opts="",
        #spark_runner="",
        #spark_master="",
        #spark_extra="",
    wrapper:
        "master/bio/gatk/baserecalibratorspark"
