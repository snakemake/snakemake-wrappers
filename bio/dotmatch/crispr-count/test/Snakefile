rule dotmatch_crispr_count:
    input:
        library="guides.csv",
        samples="samples.tsv",
    output:
        counts="counts.mageck.tsv",
        summary="summary.json",
        sample_qc="sample_qc.tsv",
    log:
        "dotmatch.log",
    threads: 1
    params:
        extra=(
            "--guide-start 0 "
            "--guide-length 4 "
            "--k 0 "
            "--metric hamming "
            "--ambiguity-policy radius "
            "--ambiguous discard"
        ),
    wrapper:
        "master/bio/dotmatch/crispr-count"
